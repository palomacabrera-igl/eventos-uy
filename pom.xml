<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uy.edu.eventos</groupId>
    <artifactId>eventos-uy</artifactId>
    <!--
        3.0 por el Laboratorio 3, y NO 1.0, a proposito: el sitio (el otro
        repositorio) todavia trae el JAR viejo de la logica en su carpeta lib/
        con el nombre logica 1.0-SNAPSHOT. Si este proyecto tambien se llamara
        1.0-SNAPSHOT, un "mvnw install" aca pisaria ese JAR en ~/.m2 y el sitio
        dejaria de compilar. Con versiones distintas no se pueden pisar.
    -->
    <version>3.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EventosUY</name>
    <description>Plataforma eventos.uy - Programacion de Aplicaciones</description>

    <!--
        POM padre del Servidor Central: no genera ningun archivo, solo
        agrupa los dos modulos y fija lo que comparten (Java 25, UTF-8 y las
        versiones de los plugins).

          logica            -> JAR con la logica y la persistencia (JPA)
          estacion-trabajo  -> JAR con las ventanas Swing (depende de logica)

        El sitio web NO esta aca: vive en su propio repositorio
        (eventos-uy-web) y recibe la logica ya compilada, como un JAR que le
        deja scripts/publicar-logica.ps1. Es lo que pide el diagrama de
        distribucion de la letra: el Servidor Central viaja embebido adentro
        del Servidor Web, no se compila junto con el.
    -->
    <modules>
        <module>logica</module>
        <module>estacion-trabajo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <junit.version>5.13.4</junit.version>
    </properties>

    <!--
        Una sola version de JAXB (la biblioteca que convierte objetos en XML).

        Hibernate trae JAXB 4.0.2 y jaxws-rt (los servicios web) trae JAXB 4.0.9.
        Las dos tienen clases con el mismo nombre: si conviven versiones distintas,
        gana la que Java encuentre primero y aparecen errores como
        NoSuchMethodError en tiempo de ejecucion. Este BOM fija todo JAXB en la
        version que pide jaxws-rt 4.0.5.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-bom</artifactId>
                <version>4.0.9</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <!--
                        Cubrimiento de sentencias de la capa logica (letra, 7.5).
                        Es la version que usa la demo del curso. La 0.8.12 no lee
                        las clases de Java 25 y el informe sale vacio.
                    -->
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
