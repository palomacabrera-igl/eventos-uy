<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uy.edu.eventos</groupId>
        <artifactId>eventos-uy</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>servidor-web</artifactId>
    <packaging>war</packaging>
    <name>EventosUY - Servidor Web</name>

    <dependencies>
        <!-- La logica viaja DENTRO del WAR, en WEB-INF/lib -->
        <dependency>
            <groupId>uy.edu.eventos</groupId>
            <artifactId>logica</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- API de servlets: la pone Tomcat, por eso "provided" (no va en el WAR) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- El WAR se llamara eventos-uy.war -->
        <finalName>eventos-uy</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <!-- Todavia no hay web.xml: se agrega en el esqueleto web -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
