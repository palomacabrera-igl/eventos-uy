<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uy.edu.eventos</groupId>
        <artifactId>eventos-uy</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logica</artifactId>
    <packaging>jar</packaging>
    <name>EventosUY - Logica</name>

    <properties>
        <!-- Clase que corre "mvnw -pl logica exec:java". Se cambia con -Dexec.mainClass=... -->
        <exec.mainClass>persistencia.CargarDatos</exec.mainClass>
    </properties>

    <dependencies>
        <!-- JUnit 5: disponible solamente al compilar y ejecutar pruebas. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JPA 3.1 API -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- Hibernate 6 (implementacion JPA) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.15.Final</version>
        </dependency>

        <!-- Driver JDBC de PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!--
                Mide que porcentaje de las sentencias de la logica ejecutan
                las pruebas. La letra, en 7.5, pide 80%.

                prepare-agent engancha un vigilante a la JVM que corre las
                pruebas; report arma el informe cuando terminan. Queda en:
                    logica/target/site/jacoco/index.html

                Se corre con:  ./mvnw -pl logica test
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!--
                            Los datos de prueba no son logica de negocio: son
                            el juego de datos con el que se carga la base. La
                            letra pide el cubrimiento de la CAPA LOGICA, y
                            contarlos aca solo esconderia el numero real.
                        -->
                        <exclude>logica/DatosDePrueba.class</exclude>
                        <exclude>persistencia/CargarDatos.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
