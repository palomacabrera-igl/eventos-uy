<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <persistence-unit name="eventosuy" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!--
          Las 10 entidades del dominio. Todas mapeadas: como se referencian
          entre si, JPA no arranca si alguna queda afuera.
        -->
        <class>logica.Usuario</class>
        <class>logica.Asistente</class>
        <class>logica.Organizador</class>
        <class>logica.Institucion</class>
        <class>logica.Categoria</class>
        <class>logica.Evento</class>
        <class>logica.EdicionEvento</class>
        <class>logica.TipoRegistro</class>
        <class>logica.Registro</class>
        <class>logica.Patrocinio</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
            <!--
                La direccion de la base, el usuario y la contrasena NO van aca:
                salen de ~/.eventosUy/central.properties (bd.url, bd.usuario y
                bd.password), como pide la letra. Los agrega Persistencia al crear
                la fabrica (ver persistencia.Configuracion).
            -->

            <property name="hibernate.hbm2ddl.auto"  value="update"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
            <property name="hibernate.dialect"       value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>

</persistence>