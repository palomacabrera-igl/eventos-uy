<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="presentacion.AceptarRechazarEdicionPanel">
  <grid id="ar000" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="15" left="15" bottom="15" right="15"/>
    <constraints>
      <xy x="20" y="20" width="620" height="380"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="ar001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Aceptar/Rechazar Edición de Evento"/>
        </properties>
      </component>
      <component id="ar002" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Evento"/>
        </properties>
      </component>
      <component id="ar003" class="javax.swing.JComboBox" binding="comboEventos">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="ar004" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Ediciones Ingresadas"/>
        </properties>
      </component>
      <scrollpane id="ar005">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="380" height="160"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ar006" class="javax.swing.JList" binding="listaEdiciones">
            <constraints/>
            <properties>
              <selectionMode value="0"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="ar007" class="javax.swing.JLabel" binding="etiquetaDetalle">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Elegí un evento para ver sus ediciones Ingresadas."/>
        </properties>
      </component>
      <component id="ar008" class="javax.swing.JButton" binding="botonCerrar">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cerrar"/>
        </properties>
      </component>
      <component id="ar009" class="javax.swing.JButton" binding="botonRechazar">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="false"/>
          <text value="Rechazar"/>
        </properties>
      </component>
      <component id="ar010" class="javax.swing.JButton" binding="botonAceptar">
        <constraints>
          <grid row="4" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="false"/>
          <text value="Aceptar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
