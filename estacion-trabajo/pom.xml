<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uy.edu.eventos</groupId>
        <artifactId>eventos-uy</artifactId>
        <version>3.0-SNAPSHOT</version>
    </parent>

    <artifactId>estacion-trabajo</artifactId>
    <packaging>jar</packaging>
    <name>EventosUY - Estacion de Trabajo</name>

    <properties>
        <!-- Clase que corre "mvnw -pl estacion-trabajo exec:java": publica los servicios web y
             despues abre la Estacion (servicios.Main). Se cambia con -Dexec.mainClass=... -->
        <exec.mainClass>servicios.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- La logica y la persistencia -->
        <dependency>
            <groupId>uy.edu.eventos</groupId>
            <artifactId>logica</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Soporte en tiempo de ejecucion del Swing UI Designer de IntelliJ -->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>forms_rt</artifactId>
            <version>7.0.3</version>
        </dependency>

        <!-- FlatLaf: look and feel moderno para Swing -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.2</version>
        </dependency>

        <!-- Lector de imagenes WebP para ImageIO: varias imagenes de los datos de
             prueba son WebP y Java solo lee png, jpg y gif. Se registra solo. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>

        <!--
            Servicios web SOAP (Jakarta XML Web Services). Es la implementacion de
            referencia, la misma version que usa la demo del curso. Trae las
            anotaciones (@WebService, @WebMethod...), la clase Endpoint que publica
            el servicio, y JAXB, que convierte los DT en XML y viceversa.
            Desde Java 11 el JDK ya no la incluye.
        -->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.5</version>
        </dependency>

        <!-- JUnit 5: solo al compilar y ejecutar pruebas. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>servicios.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!--
                servidor.jar (letra, 7.9): un JAR ejecutable con TODO adentro, que
                se arranca con "java -jar servidor.jar", sin IntelliJ ni Maven.

                maven-shade-plugin junta en un solo JAR las clases de este modulo,
                las de la logica y las de todas las bibliotecas (Hibernate, el
                driver de PostgreSQL, JAX-WS, FlatLaf...). Lo arma al final de
                "mvnw package" y lo deja en estacion-trabajo/target/servidor.jar.

                Dos detalles que hacen que funcione fuera de IntelliJ:

                  - ServicesResourceTransformer: varias bibliotecas declaran sus
                    implementaciones en archivos META-INF/services con el MISMO
                    nombre (Hibernate, JAXB, JAX-WS). Sin este transformer el JAR
                    se queda con uno solo y aparecen errores como
                    "Implementation of Jakarta XML Binding-API has not been found".
                    Con el, los junta.
                  - Se excluyen las firmas (*.SF, *.DSA, *.RSA) de las bibliotecas
                    firmadas: al mezclarlas en un JAR nuevo dejan de valer y Java
                    se niega a arrancar.

                Es la misma configuracion que usa la demo del curso.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>servidor</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>servicios.Main</mainClass>
                                    <manifestEntries>
                                        <!-- Varias bibliotecas traen clases distintas segun la version de Java. -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
